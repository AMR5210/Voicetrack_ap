# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Local PostgreSQL)
DB_NAME=voicetrack_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# AWS Credentials (Add these when ready)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=voicetrack-audio-files
AWS_S3_REGION_NAME=us-east-1

# AWS RDS (Production Database - Add later)
# RDS_DB_NAME=voicetrack_db
# RDS_USERNAME=admin
# RDS_PASSWORD=your-rds-password
# RDS_HOSTNAME=your-rds-endpoint
# RDS_PORT=5432

# Celery (Optional - for async processing)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS Settings (for mobile app)
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081

# Email (Optional - for password reset)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
